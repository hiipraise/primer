# â”€â”€â”€ Primer â€” Environment Variables â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copy this file to .env.local and fill in your values.
# Required variables will cause the app to fail at startup if missing.

# â”€â”€â”€ Supabase â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Your Supabase project URL and anon/public key.
# Found in: Supabase Dashboard â†’ Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only â€” used by createServiceRoleClient() to bypass RLS
# for internal tables like anon_sessions. NOT exposed to the client.
# Found in: Supabase Dashboard â†’ Settings â†’ API â†’ service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# â”€â”€â”€ Groq API â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# API key for Groq's Llama 3.3 70B model (used for recommendations).
# Get one at: https://console.groq.com/keys
# Free tier: 30 req/min on Llama 3.3 70B â€” enough for development.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Rate limiting uses Upstash Redis in production; required outside development.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Anonymous usage quota (defaults to 3 if unset or invalid).
ANON_GENERATION_CAP=3

# â”€â”€â”€ Site URL (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Your app's public URL. Used for OAuth redirects.
# Defaults to http://localhost:3000 in development.
# In production, set this to your Vercel deployment URL or custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app


# Optional monetization (ads load only after consent and when the slot is visible).
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_GENERATION_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_PUBLIC_PROMPT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_EXPLORE_SIDEBAR=
# For a custom ad provider, configure both values and implement against data-ad-position.
NEXT_PUBLIC_AD_SCRIPT_URL=
ADS_TXT_CONTENT=

# Optional telemetry, activated only after the visitor allows optional services.
NEXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Exchange-rate assumption for USD equivalents shown with NGN cost estimates.
# This is a planning input, not a live market rate.
NEXT_PUBLIC_USD_NGN_ESTIMATE_RATE=1500
